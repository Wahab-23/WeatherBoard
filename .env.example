# WeatherBoard Environment Variables

# OpenWeatherMap API Key (Free tier: Current Weather + 5-Day/3-Hour Forecast)
# https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# GeoDB Cities API via RapidAPI
# https://rapidapi.com/wirefreethought/api/geodb-cities
VITE_RAPIDAPI_KEY=
VITE_RAPIDAPI_HOST=wft-geo-db.p.rapidapi.com

# Note: WeatherBoard includes seamless automatic fallback to Open-Meteo API
# (which requires no API key for both City Geocoding and Weather Forecasts)
# if keys are omitted, invalid, or rate-limited.
